APP_PORT=3000
NEW_API_IMAGE_TAG=replace-with-full-40-character-reviewed-sha
SQL_DSN=postgresql://newapi:replace-with-url-encoded-password@private-managed-postgres-host:25060/newapi?sslmode=verify-full&sslrootcert=/etc/new-api/db/ca-certificate.crt
MANAGED_POSTGRES_CA_CERT_PATH=/absolute/path/to/ca-certificate.crt
POSTGRES_PASSWORD=replace-with-random-hex
REDIS_PASSWORD=replace-with-random-hex
SESSION_SECRET=replace-with-random-hex
CRYPTO_SECRET=replace-with-different-random-hex
SESSION_COOKIE_TRUSTED_URL=https://code-token.ai,https://www.code-token.ai
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
